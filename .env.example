# Optional project data location
BDM_DATA_ROOT=

# Local Ollama defaults; override when needed
BDM_OLLAMA_NUM_CTX=4096
BDM_OLLAMA_KEEP_ALIVE=5m

# LLM request settings
BDM_LLM_TIMEOUT_LOCAL=120
BDM_LLM_TIMEOUT_HOSTED=60
BDM_LLM_RETRY_COUNT=2
BDM_LLM_TEMPERATURE=0

# Hosted OpenAI-compatible provider (leave blank until configured)
BDM_HOSTED_BASE_URL=
BDM_HOSTED_MODEL=
BDM_HOSTED_API_KEY=

# Set to 1 only when intentionally running live LLM tests
BDM_RUN_LIVE_LLM=0